{
  "name": "@dsh-plugins/nativecrew",
  "version": "0.2.0-rc.29",
  "description": "NativeCrew 原生协作：隔离沙箱中的原生 Agent 自动派工与任务交接。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webkubor/nativecrew.git"
  },
  "homepage": "https://github.com/webkubor/nativecrew#readme",
  "type": "module",
  "exports": {
    ".": "./src/host/plugin.js",
    "./client": "./client.js",
    "./assets/godbot-icon-*.png": "./src/host/assets/godbot-icon-*.png",
    "./web-search": "./src/host/workspace-search.js",
    "./package.json": "./package.json",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./assets/nativecrew-icon-*.png": "./src/host/assets/nativecrew-icon-*.png"
  },
  "files": [
    "bin",
    "computer-host",
    "src/host",
    "src/drivers",
    "src/team",
    "client.js",
    "cordis.patch.yml",
    "THIRD_PARTY_NOTICES",
    "licenses",
    "FEATURE_PARITY.md",
    "README.md",
    "CHANGELOG.md",
    "icon.svg",
    "locale",
    "brand"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=24.9",
    "dsh": "0.2.2-rc.5"
  },
  "scripts": {
    "build": "node scripts/build-link.mjs && node scripts/build-client.mjs",
    "test": "node --test test/**/*.test.js",
    "test:e2e": "node scripts/e2e.mjs",
    "typecheck": "tsc -p src/link"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-subprocess-local": "0.2.2-rc.5",
    "@lukeburns/clatterjs": "1.0.0",
    "@noble/ciphers": "1.3.0",
    "@noble/curves": "1.9.7",
    "@noble/hashes": "1.8.0",
    "@types/node": "24.19.2",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "esbuild": "0.28.2",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-app-boot": "0.2.2-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.5",
    "@deepseek-ai/dsh-scope": "0.2.2-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.5",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.5",
    "@deepseek-ai/dsh-web": "0.2.2-rc.5"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@xmldom/xmldom": "0.9.12",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/headless": "6.0.0",
    "deep-view": "0.1.2",
    "imapflow": "2.9.1",
    "jpeg-js": "0.4.4",
    "mailparser": "3.12.4",
    "nodemailer": "10.2.1",
    "openid-client": "6.9.1",
    "playwright-core": "1.64.1",
    "pngjs": "7.0.0",
    "qrcode-generator": "2.0.4",
    "undici": "8.13.1",
    "ws": "8.23.0"
  },
  "bin": {
    "godbot": "bin/godbot.mjs",
    "godbot-computer": "computer-host/cli.mjs",
    "nativecrew": "bin/nativecrew.mjs"
  },
  "bugs": {
    "url": "https://github.com/webkubor/nativecrew/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "icon": "./icon.svg"
}
